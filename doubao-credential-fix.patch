+    /// Stamp the credentials as issued right now
+    pub fn mark_issued_now(&mut self) {
+        self.issued_at_ms = Some(current_time_ms());
+    }
+
+    /// Age of the credentials, if the issue time is known
+    pub fn age(&self) -> Option<Duration> {
+        let issued = self.issued_at_ms?;
+        let now = current_time_ms();
+        Some(Duration::from_millis(now.saturating_sub(issued)))
+    }
+
+    /// Whether the credentials are complete AND still within the TTL.
+    ///
+    /// The Doubao ASR token is short lived. An expired token does not produce a
+    /// clean rejection at connect time: the websocket handshake is dragged out
+    /// for tens of seconds and the session then fails with
+    /// `service discovery failure`. Treating an old token as unusable up front
+    /// avoids that dead end entirely.
+    pub fn is_usable(&self, ttl_days: u64) -> bool {
+        if !self.is_complete() {
+            return false;
+        }
+        // TTL of 0 disables expiry checking.
+        if ttl_days == 0 {
+            return true;
+        }
+        match self.age() {
+            Some(age) => age < Duration::from_secs(ttl_days * 24 * 60 * 60),
+            // No timestamp => written by an older build => assume expired.
+            None => false,
+        }
+    }
