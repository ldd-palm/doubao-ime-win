# Doubao Voice Input - Configuration File
# 豆包语音输入配置文件

[general]
# 开机自启动
auto_start = false
# 语言
language = "zh-CN"

[hotkey]
# 热键模式: "combo" (组合键) / "double_tap" (双击) / "single_tap" (单击)
mode = "combo"
# 组合键 (当 mode = "combo" 时生效)
combo_key = "Ctrl+Shift+V"
# 触发键 (当 mode = "double_tap" 或 "single_tap" 时生效)
# 可选: Ctrl/LCtrl/RCtrl, Shift/LShift/RShift, Alt/LAlt/RAlt，
# 不带 L/R 前缀表示左右键都触发
double_tap_key = "Ctrl"
# 双击间隔 (毫秒，仅 double_tap 模式生效)
double_tap_interval = 300
# 按住触发键（double_tap_key）的同时按下这个键 = 暂停/恢复整个服务（而不是
# 切换录音）。悬浮按钮隐藏=已暂停，重新出现=已恢复。留空 "" 表示关闭这个功能。
# 支持: Space/Enter/Tab/Escape、F1-F12、单个字母或数字。
pause_combo_key = "Space"

[floating_button]
# 是否显示悬浮按钮
enabled = true
# 悬浮按钮位置 (像素)
position_x = 100
position_y = 100

[asr]
# 是否启用 VAD (语音活动检测)
vad_enabled = true
# 设备凭据的最长缓存天数。豆包 ASR token 会在服务端过期，
# 过期后握手会卡住十几秒再报 service discovery failure，
# 因此到期前主动重新注册。设为 0 表示不做过期检查。
credential_ttl_days = 3
# 建立 ASR WebSocket 连接的超时时间（秒）
connect_timeout_secs = 8

[llm]
# ============================================================
# 大模型纠错（可选）：用大模型修正识别结果里的同音字/错别字/标点。
# 默认关闭，不影响语音识别本身。想用的话三步：
#   1. 去 DeepSeek（https://platform.deepseek.com）或火山方舟等平台申请 API Key
#   2. 把 model / base_url / api_key 三项填好（或者 api_key 留空，改用下面
#      说的 LLM_API_KEY 环境变量——更安全，不怕这个文件被转发出去）
#   3. enabled 改成 true
# ============================================================
enabled = false
# 模型名 / 推理接入点 ID，会作为请求里的 model 字段，例如 DeepSeek 的
# "deepseek-flash"；火山方舟填 ep-xxxxx 形式的接入点 ID。
# ⚠️ 必填——enabled=true 但这里留空，纠错功能会自动跳过并在日志里报警告。
model = ""
# ⚠️ 你的 API Key，请自行申请并填在这里——默认不带任何 key。
# 也可以留空 ""，改成设置环境变量 LLM_API_KEY（推荐：不怕这份配置文件被转发
# 或提交到别处时明文泄露）。两者都填了的话，环境变量优先。
api_key = ""
# OpenAI 兼容的 Chat Completions 接口地址。DeepSeek 是
# https://api.deepseek.com/chat/completions；火山方舟是
# https://ark.cn-beijing.volces.com/api/v3/chat/completions
base_url = "https://api.deepseek.com/chat/completions"
# 纠错请求超时时间（秒），超时则直接用原始识别结果，不阻塞输入
timeout_secs = 5
